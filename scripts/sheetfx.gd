extends RefCounted
# Pixel art effects from pixelfx (https://github.com/patch-gg/pixelfx, MIT: assets/fx/pixelfx/LICENSE.txt),
# baked to sprite sheets (glow off, so they don't leave a dark haze on bright ground). Generated by the trial script;
# each entry: frame size, columns, frame count, fps, loop and the pivot (the effect's origin in the frame).
# Overhead status effects are drawn for a 38 px tall stand-in character: HEAD lifts the anchor to its head.

const HEAD := 38.0
const META := {
	"confused": {"w": 60, "h": 78, "cols": 10, "frames": 72, "fps": 30, "loop": true, "pivot": Vector2(30, 70)},
	"sleep": {"w": 60, "h": 82, "cols": 10, "frames": 72, "fps": 30, "loop": true, "pivot": Vector2(26, 74)},
	"paralysis": {"w": 60, "h": 64, "cols": 8, "frames": 60, "fps": 30, "loop": true, "pivot": Vector2(30, 56)},
	"crit_hit": {"w": 216, "h": 136, "cols": 5, "frames": 28, "fps": 30, "loop": false, "pivot": Vector2(84, 106)},
	"collect_burst": {"w": 112, "h": 108, "cols": 7, "frames": 42, "fps": 30, "loop": false, "pivot": Vector2(56, 94)},
	"xp_orb": {"w": 72, "h": 56, "cols": 7, "frames": 54, "fps": 30, "loop": true, "pivot": Vector2(36, 48)},
}

static var _tex := {}


static func tex(id: String) -> Texture2D:
	if not _tex.has(id):
		var p: String = "res://assets/fx/pixelfx/%s.png" % id
		_tex[id] = load(p) if ResourceLoader.exists(p) else null
	return _tex[id]


static func duration(id: String) -> float:
	var m: Dictionary = META[id]
	return float(m["frames"]) / float(m["fps"])


# Draws effect id at time t (seconds since it started) with its anchor on pos, scaled by scl (world units per effect
# pixel). anchor defaults to the effect's pivot; pass head = true for overhead status effects. Returns false once a
# one-shot effect has finished (loops never finish).
static func draw(ci: CanvasItem, id: String, pos: Vector2, t: float, scl: float, alpha: float = 1.0, head: bool = false) -> bool:
	var m: Dictionary = META[id]
	var n: int = int(m["frames"])
	var f: int = int(t * float(m["fps"]))
	if bool(m["loop"]):
		f = posmod(f, n)
	elif f >= n or f < 0:
		return false
	var tx: Texture2D = tex(id)
	if tx == null:
		return false
	var w: float = float(m["w"])
	var h: float = float(m["h"])
	var cols: int = int(m["cols"])
	var src := Rect2(float(f % cols) * w, float(f / cols) * h, w, h)
	var piv: Vector2 = m["pivot"]
	if head:
		piv.y -= HEAD
	ci.draw_texture_rect_region(tx, Rect2(pos - piv * scl, Vector2(w, h) * scl), src, Color(1, 1, 1, alpha))
	return true
